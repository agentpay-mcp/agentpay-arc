[Unit]
Description=AgentPay Arc hosted web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agentpay-arc-web
Group=agentpay-arc-web
WorkingDirectory=/opt/agentpay-arc/releases/@RELEASE_COMMIT@
Environment=NODE_ENV=production
EnvironmentFile=/etc/agentpay-arc/web.env
ExecStartPre=/usr/bin/node /opt/agentpay-arc/releases/@RELEASE_COMMIT@/deploy/arc/validate-env.mjs web /opt/agentpay-arc/releases/@RELEASE_COMMIT@/apps/arc-web/dist/arc-artifact-manifest.json
ExecStart=/usr/bin/node /opt/agentpay-arc/releases/@RELEASE_COMMIT@/deploy/arc/static-server.mjs --host 127.0.0.1 --port 3101 --root apps/arc-web/dist
ExecStartPost=/usr/bin/curl --fail --silent --show-error --max-time 5 http://127.0.0.1:3101/healthz
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SocketBindDeny=any
SocketBindAllow=tcp:3101
ReadOnlyPaths=/opt/agentpay-arc/releases/@RELEASE_COMMIT@
InaccessiblePaths=/etc/agentpay-arc/mcp.env
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agentpay-arc-web
LogRateLimitIntervalSec=30s
LogRateLimitBurst=500

[Install]
WantedBy=multi-user.target
