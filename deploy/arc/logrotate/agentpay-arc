/var/log/agentpay-arc/*.jsonl /var/log/agentpay-arc/*.log {
    daily
    rotate 14
    maxsize 32M
    missingok
    notifempty
    compress
    delaycompress
    create 0640 www-data adm
    sharedscripts
    postrotate
        test ! -r /run/nginx.pid || kill -USR1 "$(cat /run/nginx.pid)"
    endscript
}
